# =====================================================================
# Copie este arquivo para .env.local e preencha. NUNCA suba o .env.local
# nem a chave secreta para o GitHub.
# =====================================================================

# Nome que aparece na tela inicial: "Agenda <nome>"
NEXT_PUBLIC_NOME_EMPRESA=Studio Exemplo

# --- Supabase (Project Settings > API Keys) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave PÚBLICA (publishable). Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Alternativa legada (projetos antigos): a chave "anon". Use uma ou outra.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave SECRETA (só no servidor, sem o prefixo NEXT_PUBLIC_). Usada apenas
# no login por usuário e no cadastro. Nunca exponha no front-end.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Alternativa legada: a chave "service_role".
# SUPABASE_SERVICE_ROLE_KEY=

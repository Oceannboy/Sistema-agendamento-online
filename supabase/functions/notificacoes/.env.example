# Segredos da Edge Function "notificacoes".
# Defina com:  supabase secrets set --env-file supabase/functions/notificacoes/.env
# (copie este arquivo para .env, preencha e NÃO suba o .env para o GitHub)
#
# SUPABASE_URL e a chave de serviço já são fornecidas automaticamente pelo Supabase.

# Mesmo valor guardado no Vault como "notificacoes_segredo" (segredo longo e aleatório).
NOTIFICACOES_SEGREDO=troque-por-um-segredo-longo-e-aleatorio

# Provedor de e-mail (Resend). Crie a chave em resend.com > API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Remetente. Em produção precisa ser de um domínio verificado no Resend.
# Para testes: "Agenda <onboarding@resend.dev>" (só entrega para o e-mail dono da conta Resend).
EMAIL_REMETENTE=Studio Exemplo <agenda@seudominio.com.br>

# Aparecem no texto do e-mail.
NOME_EMPRESA=Studio Exemplo
SITE_URL=https://seu-site.vercel.app
